# ==========================================
# LeadGen AI - Root Environment Template
# ==========================================

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./leadgen.db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Automation & Integrations (n8n, Google Workspace)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/leads
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GMAIL_SENDER_ADDRESS=your_email@gmail.com
GMAIL_ACCESS_TOKEN=your_gmail_access_token_here
